RewriteEngine On
RewriteBase /rea-1/PHP/26-eindopdracht-php/mijn-blog/

# ---------------------------
# Root naar index.php
# ---------------------------
RewriteRule ^$ index.php [L]

# ---------------------------
# Statische pagina's
# Voorbeeld: /home → index.php
# ---------------------------
RewriteRule ^home$ index.php [L,QSA]
RewriteRule ^contact$ contact.php [L,QSA]
RewriteRule ^about$ about.php [L,QSA]
RewriteRule ^posts$ postsPage.php [L,QSA]

# ---------------------------
# Profiel acties met slug
# Voorbeeld: /profile/edit/appeltaart → profile.php?tab=edit&slug=appeltaart
# ---------------------------
RewriteRule ^profile/(edit|delete)/([a-zA-Z0-9-]+)$ profile.php?tab=$1&slug=$2 [L,QSA]

# ---------------------------
# Profiel tabs
# Voorbeeld: /profile/posts → profile.php?tab=posts
# ---------------------------
RewriteRule ^profile/([a-zA-Z0-9-]+)$ profile.php?tab=$1 [L,QSA]

# ---------------------------
# Comment verwijderen
# Voorbeeld: /appeltaart/delete_comment/15 → currentPost.php?post=appeltaart&action=delete_comment&id=15
# ---------------------------
RewriteRule ^([a-zA-Z0-9-]+)/delete_comment/([0-9]+)$ currentPost.php?post=$1&action=delete_comment&id=$2 [L,QSA]

# ---------------------------
# Post detailpagina’s
# Voorbeeld: /appeltaart → currentPost.php?post=appeltaart
# ---------------------------
RewriteRule ^([a-zA-Z0-9-]+)$ currentPost.php?post=$1 [L,QSA]

# Eigen 404 pagina
ErrorDocument 404 /rea-1/PHP/26-eindopdracht-php/mijn-blog/404.php